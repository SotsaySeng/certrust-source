# Production SECRETS for api.certrust.app.
#
# Copy to src/backend/.env.production (gitignored) and fill in. Never paste
# these anywhere else. push-secrets.sh uploads them with `wrangler secret bulk`.
# Non-secret settings (URLs, bucket names, SMTP host...) live in
# deploy/cloudflare/api/wrangler.jsonc instead.

# --- Must be IDENTICAL to src/backend/.env --------------------------------
# Leave these blank: push-secrets.sh copies them from src/backend/.env.
# ENCRYPTION_KEY decrypts every issuer's signing key - a different value makes
# all existing credentials unverifiable. Keep a copy in a password manager.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Neon Postgres ----------------------------------------------------------
# Neon dashboard -> your project -> Connect -> connection string with
# "Connection pooling" switched OFF (the direct one, no "-pooler" in the host):
# Strapi's schema sync and migrations at boot are safest on a direct
# connection, and one backend only opens a handful anyway. e.g.
# postgresql://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Cloudflare Email Service --------------------------------------------------
# API token with the "Email Sending: Edit" permission (username is api_token).
SMTP_PASSWORD=

# --- Cloudflare R2 (uploads + backups) ---------------------------------------
# R2 -> Manage API tokens -> Create token, "Object Read & Write" on the
# certrust-files and certrust-backups buckets. Endpoint:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Internal ---------------------------------------------------------------
# Shared secret for the daily-backup cron -> /api/ops/backup. Leave blank and
# push-secrets.sh generates one.
OPS_TOKEN=

# --- Optional, later --------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_ENT_MONTHLY=
# STRIPE_PRICE_ENT_YEARLY=
