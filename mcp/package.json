{
  "name": "@certrust/mcp",
  "version": "1.0.0",
  "description": "Connect AI assistants to Certrust: issue, verify and manage Open Badges 3.0 credentials. A stdio bridge to the hosted MCP endpoint (https://api.certrust.app/mcp).",
  "type": "module",
  "bin": {
    "certrust-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
