# Database
DATABASE_CLIENT=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db
JWT_SECRET=ibDcvUu3lpOgomNOPvxIkw==
# Outgoing email (signup confirmation, password reset, credential
# notifications). SMTP_FROM also becomes the sender of the confirmation and
# reset emails (bootstrap/email-sender-setup.ts), so it must be an address the
# provider lets you send from.
#
# Local dev: DEV_MAIL_CATCHER=true below and the in-process catcher on
# 127.0.0.1:1025 (the defaults when SMTP_HOST/SMTP_PORT are unset), so signup's
# mandatory confirmation email can never block registration.
#
# Cloudflare Email Service (needs your domain onboarded for Email Sending):
#   SMTP_HOST=smtp.mx.cloudflare.net  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USERNAME=api_token  SMTP_PASSWORD=<API token with "Email Sending: Edit">
#   SMTP_FROM="Certrust <certificates@your-domain>"
#
# Gmail (needs 2-Step Verification and an App Password; ~500 recipients/day;
# From must be the Gmail address itself or Gmail rewrites it):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM="Certrust <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
# Sending is pooled and paced so a batch issuance isn't rejected as a burst.
SMTP_MAX_CONNECTIONS=2
SMTP_RATE_PER_SECOND=2
# Help address shown in credential emails (defaults to SMTP_REPLY_TO).
SUPPORT_EMAIL=

# CORS - comma-separated list of extra allowed origins for your own domain(s),
# on top of the localhost/Netlify/schroedinger-hat defaults baked into
# config/middlewares.ts. Only needed for self-hosted deployments.
# e.g. CORS_ALLOWED_ORIGINS=https://badges.example.org,https://api.badges.example.org
CORS_ALLOWED_ORIGINS=

# Logging - set to true to emit structured JSON logs (with a per-request
# requestId) instead of the default colored console output. Meant for
# production/self-hosted deployments piping logs to Loki/ELK/Splunk - see
# docs/logging.md. Leave unset for local dev.
LOG_FORMAT_JSON=

# Uploads - local disk by default. Set UPLOAD_PROVIDER=s3 to use an
# S3-compatible bucket instead (required for more than one backend replica -
# see docs/self-hosting.md and docs/kubernetes.md). S3_ENDPOINT and
# S3_FORCE_PATH_STYLE are only needed for non-AWS S3-compatible services
# (MinIO, Cloudflare R2, etc.) - leave both unset for real AWS S3.
UPLOAD_PROVIDER=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Leave empty for Cloudflare R2 (no ACL support); defaults to public-read.
S3_ACL=
# Public base URL files are served from, e.g. an R2 custom domain
# (https://files.example.org). Needed for R2, whose S3 endpoint is private.
S3_PUBLIC_URL=

# Off-site backups (scripts/backup-offsite.js, `npm run backup:offsite`):
# pg_dump + a mirror of the uploads bucket, into this separate bucket, using
# the S3_* credentials above.
BACKUP_S3_BUCKET=
# Shared secret for POST /api/ops/backup (called by the Cloudflare cron).
# The endpoint is disabled while this is empty.
OPS_TOKEN=

# Set to true behind a reverse proxy / Cloudflare so the rate limiter sees
# the visitor's IP (X-Forwarded-For) instead of the proxy's.
IS_PROXIED=false
# With NODE_ENV=production the backend refuses to start unless
# DATABASE_CLIENT=postgres and UPLOAD_PROVIDER=s3, because container disks
# are wiped on restart. Set true only if this host has persistent volumes
# (e.g. docker-compose with the uploads-data volume).
ALLOW_LOCAL_STORAGE=false

# Channel Alerts — admin/team notifications for Slack, Microsoft Teams, Discord
# Any subset can be configured; leave blank to disable a provider.
# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Microsoft Teams: Channel Settings → Integrations → Webhooks
TEAMS_WEBHOOK_URL=
# Discord: Channel Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# Development only. Starts an SMTP sink inside Strapi on SMTP_PORT (default
# 1025) that accepts any message, saves it to .tmp/mail/ and logs its links.
# Ignored when NODE_ENV=production. See src/bootstrap/dev-mail-catcher.ts.
DEV_MAIL_CATCHER=false

# Background billing scanner (trial/renewal reminders, trial expiry,
# past-due downgrades). Set to false until Stripe is live, or it emails every
# org about trials nobody can pay for and downgrades them when trials end.
BILLING_SCANNER_ENABLED=true

# Stripe billing (api::billing). Leave STRIPE_SECRET_KEY empty to run with
# online payments switched off - the billing page then says so and trials,
# reminders and the revenue dashboard still work.
# Keys: https://dashboard.stripe.com/test/apikeys
# Webhook: point Stripe (or `stripe listen --forward-to localhost:1337/api/billing/webhook`)
# at /api/billing/webhook for checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid and
# invoice.payment_failed, and paste its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring Price per plan, created in the Stripe dashboard (USD).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENT_MONTHLY=
STRIPE_PRICE_ENT_YEARLY=
