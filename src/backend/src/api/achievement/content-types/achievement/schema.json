{
  "kind": "collectionType",
  "collectionName": "achievements",
  "info": {
    "singularName": "achievement",
    "pluralName": "achievements",
    "displayName": "Achievement",
    "description": "Open Badges 3.0 Achievement (Badge Class) definition"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "achievementType": {
      "type": "string",
      "default": "Achievement"
    },
    "templateType": {
      "type": "enumeration",
      "enum": [
        "certificate",
        "badge",
        "transcript",
        "training_record",
        "assessment",
        "letter"
      ],
      "default": "badge"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "criteria": {
      "type": "component",
      "repeatable": false,
      "component": "badge.criteria"
    },
    "tags": {
      "type": "json",
      "default": []
    },
    "achievementId": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "alignment": {
      "type": "component",
      "repeatable": true,
      "component": "badge.alignment"
    },
    "creator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile"
    },
    "skills": {
      "type": "component",
      "repeatable": true,
      "component": "badge.skill"
    },
    "certificateDesignId": {
      "type": "string",
      "description": "documentId of the default certificate design (design-template). A plain documentId, not a relation: a relation to a draftAndPublish type is orphaned whenever that template is edited (republish = new numeric id)."
    },
    "badgeDesignId": {
      "type": "string",
      "description": "documentId of the default badge design (design-template). See certificateDesignId."
    }
  }
}
