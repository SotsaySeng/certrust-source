{
  "kind": "collectionType",
  "collectionName": "credentials",
  "info": {
    "singularName": "credential",
    "pluralName": "credentials",
    "displayName": "Credential",
    "description": "Open Badges 3.0 Credential (Badge Award)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "credentialId": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 36,
      "maxLength": 255,
      "regex": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "json",
      "default": [
        "VerifiableCredential",
        "OpenBadgeCredential"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "issuanceDate": {
      "type": "datetime",
      "required": true
    },
    "expirationDate": {
      "type": "datetime"
    },
    "achievement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::achievement.achievement"
    },
    "issuer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile"
    },
    "recipient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile"
    },
    "narrative": {
      "type": "text"
    },
    "proof": {
      "type": "component",
      "repeatable": true,
      "component": "badge.proof"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocationReason": {
      "type": "text"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "issuedToMinor": {
      "type": "boolean",
      "default": false
    },
    "statusList": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::revocation-list.revocation-list"
    },
    "statusListIndex": {
      "type": "integer"
    },
    "customFields": {
      "type": "json"
    },
    "certificateDesignSnapshot": {
      "type": "json"
    },
    "badgeDesignSnapshot": {
      "type": "json"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "eventSnapshot": {
      "type": "json"
    },
    "designTemplateId": {
      "type": "string",
      "description": "documentId of the design-template the certificate snapshot was taken from (reference only - rendering uses certificateDesignSnapshot)."
    }
  }
}
