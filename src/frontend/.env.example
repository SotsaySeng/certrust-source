# API URL for the Strapi backend
NUXT_PUBLIC_API_URL=http://localhost:1337

# Google Analytics 4 measurement ID (optional — omit to disable analytics)
# NUXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Public website URL used for canonical links, OG images, QR codes (optional)
# Defaults to http://localhost:3000 if unset
# NUXT_PUBLIC_WEBSITE_URL=http://localhost:3000
